---
import linksRaw from '../data/links.md?raw';
// Parse the raw Markdown into lines
const lines = linksRaw.split(/\r?\n/).filter(l => l.trim() && !l.trim().startsWith('<!--'));
// Build sections
const sections = [];
let current = null;
for (const line of lines) {
  if (line.startsWith('# ')) {
    if (current) sections.push(current);
    current = { title: line.replace('# ', '').trim(), items: [] };
  } else {
    const match = line.match(/^\[(.*?)\]\((.*?)\)(?:\s*-\s*(.*))?$/);
    if (match && current) {
      const [, title, url, description] = match;
      current.items.push({ title, url, description: description || '' });
    }
  }
}
if (current) sections.push(current);
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Dev</title>
</head>
<body class="bg-gray-100 text-gray-900 font-sans p-8">
  <div class="container mx-auto max-w-4xl">
    <h1 class="text-4xl font-bold mb-8 text-center text-blue-700">Resources</h1>

    {sections.map(({ title, items }) => (
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4 border-b pb-2 border-gray-300">{title}</h2>
        <ul class="space-y-2">
          {items.map(item => (
            <li class="bg-white p-4 rounded shadow hover:bg-blue-50 transition duration-150">
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">{item.title}</a>
              {item.description && <p class="text-sm text-gray-600 mt-1">{item.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</body>
</html>
